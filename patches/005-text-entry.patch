         DestroyTask(FindTaskIdByFunc(Task_NamingScreen));
         FreeAllWindowBuffers();
         FREE_AND_SET_NULL(sNamingScreen);
+        gCodeRedNamingMailbox.active = FALSE;
+        gCodeRedNamingMailbox.action = 0;
+        gCodeRedNamingMailbox.requestSession = 0;
+        gCodeRedNamingMailbox.length = 0;
+        {
+            u8 i;
+            for (i = 0; i < 16; i++)
+                gCodeRedNamingMailbox.input[i] = 0;
+        }
         RestoreHelpContext();
     }
     return FALSE;
