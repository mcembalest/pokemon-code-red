diff --git a/src/code_red.c b/src/code_red.c
new file mode 100644
index 0000000..86e016a
--- /dev/null
+++ b/src/code_red.c
@@ -0,0 +1,15 @@
+#include "global.h"
+#include "gflib.h"
+#include "event_data.h"
+#include "constants/flags.h"
+
+// The Pokémon Center PC menu (src/script_menu.c) lists POKéEG above LOG OFF; data/scripts/pc.inc dispatches on
+// the choice. Map the two new positions onto the script's cases (6 = POKéEG, 4 = LOG OFF); the original 0..3 stay.
+void CodeRedMapPCChoice(void)
+{
+    u16 eegChoice = FlagGet(FLAG_SYS_GAME_CLEAR) ? 4 : (FlagGet(FLAG_SYS_POKEDEX_GET) ? 3 : 2);
+    if (gSpecialVar_Result == eegChoice)
+        gSpecialVar_Result = 6;
+    else if (gSpecialVar_Result == eegChoice + 1)
+        gSpecialVar_Result = 4;
+}
