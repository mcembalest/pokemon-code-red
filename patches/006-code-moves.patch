diff --git a/src/code_red_battle.c b/src/code_red_battle.c
new file mode 100644
index 00000000..6b331732
--- /dev/null
+++ b/src/code_red_battle.c
@@ -0,0 +1,244 @@
+#include "global.h"
+#include "battle.h"
+#include "battle_scripts.h"
+#include "battle_anim.h"
+#include "battle_main.h"
+#include "battle_util.h"
+#include "pokemon.h"
+#include "constants/battle.h"
+#include "constants/battle_string_ids.h"
+#include "constants/moves.h"
+#include "event_data.h"
+#include "constants/flags.h"
+#include "random.h"
+
+// Code moves (Code Red battle rule): when a Pokémon gets to use a move, the host
+// (browser) has it write the move's code, runs the code on the target's bytes and
+// replies hit, miss or vanilla. A miss fails the move completely and the text box
+// says why; a hit (or vanilla) lets FireRed carry on as usual, accuracy roll
+// included. Both sides. Host-optional: with no host (enabled == 0), no reply in
+// time, or a cancelled request, the move is plain FireRed. Fixed 48-byte transport.
+struct CodeRedMove {
+    u32 magic;               // 'CRM1'
+    u16 version;             // 1
+    u8 state;                // 0 idle, 1 pending, 2 reply, 4 cancelled
+    u8 enabled;              // set by the host
+    u32 requestId;
+    u32 epoch;               // stamped by the host
+    u16 move;
+    u8 attackerSide;         // 0 player, 1 opponent
+    u8 attackerLevel;
+    u16 attackerSpecies;
+    u16 targetSpecies;
+    u32 attackerPersonality; // which Pokémon is writing (its memory lives with it)
+    u32 targetPersonality;
+    u8 targetLevel;
+    u8 targetType1;          // battle types: the target's data formats
+    u8 targetType2;
+    u8 verdict;              // host: 0 vanilla, 1 hit, 2 miss
+    u32 battleTypeFlags;
+    u16 trainerId;           // opponent trainer (0 = wild)
+    u8 reason;               // host, on a miss: CODE_RED_MISS_*
+    s8 attackerStages;       // sum of the attacker's stat stage offsets (Growl: -1), for code focus
+    u16 waited;              // frames waited for this request
+    u8 trainerClass;         // gTrainers[].trainerClass (0 = wild): knowledge tier (leaders and the rival read every format)
+    u8 calledSlot;           // 0 = it used the move you called; n = it doubted you and used its own pick (you called slot n-1)
+};
+STATIC_ASSERT(sizeof(struct CodeRedMove) == 48, CodeRedMoveSize);
+EWRAM_DATA volatile struct CodeRedMove gCodeRedMove = {0};
+static EWRAM_DATA u32 sMoveRequestId = 0;
+static EWRAM_DATA bool8 sAsked = FALSE;
+static EWRAM_DATA u8 sCalledSlot = 0;
+
+#define CRM_MAGIC 0x314D5243
+#define CRM_WAIT_FRAMES 1800 // ~30 s: model + network + one retry
+
+enum { CODE_RED_VANILLA, CODE_RED_HIT, CODE_RED_MISS };
+
+// Status moves hit the foe's code (owner, 2026-10-08): the page shakes or steadies a Pokémon's code brain by the
+// sum of its stat stages (Growl, Tail Whip, Sand Attack... vs Withdraw, Harden...), capped there.
+static s8 StageSum(struct BattlePokemon *mon)
+{
+    s32 i, total = 0;
+    for (i = STAT_ATK; i < NUM_BATTLE_STATS; i++)
+        total += mon->statStages[i] - DEFAULT_STAT_STAGE;
+    return total < -12 ? -12 : total > 12 ? 12 : total;
+}
+
+// Text box after a miss (gBattleCommunication[MULTISTRING_CHOOSER] = reason).
+const u16 gCodeRedMissStringIds[] =
+{
+    STRINGID_CODEREDCRASHED,  // 0 the code threw (or never returned)
+    STRINGID_CODEREDWRONG,    // 1 wrong answer
+    STRINGID_CODEREDTOOLONG,  // 2 over the byte budget
+    STRINGID_CODEREDNOCODE,   // 3 no code block
+};
+
+static bool8 HostReady(void)
+{
+    volatile struct CodeRedMove *m = &gCodeRedMove;
+    return m->magic == CRM_MAGIC && m->version == 1 && m->enabled
+        && !(gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_POKEDUDE));
+}
+
+// TRUE while Cmd_attackcanceler is waiting on the host: it must resume here, not rerun its checks.
+void CodeRedPayloadShow(void);
+
+bool8 CodeRedMovePending(void)
+{
+    return sAsked;
+}
+
+// Called where Cmd_attackcanceler lets the move go ahead. TRUE = a request is out
+// (the command repeats next frame and CodeRedMoveContinue finishes it).
+bool8 CodeRedMoveAsk(void)
+{
+    volatile struct CodeRedMove *m = &gCodeRedMove;
+    struct BattlePokemon *a = &gBattleMons[gBattlerAttacker], *t = &gBattleMons[gBattlerTarget];
+
+    if (!HostReady() || gCurrentMove == MOVE_STRUGGLE || (a->status2 & STATUS2_MULTIPLETURNS))
+        return FALSE; // no host, or a locked-in turn of a move already coded
+    m->requestId = ++sMoveRequestId;
+    m->epoch = 0;
+    m->move = gCurrentMove;
+    m->attackerSide = GET_BATTLER_SIDE(gBattlerAttacker);
+    m->attackerLevel = a->level;
+    m->attackerSpecies = a->species;
+    m->targetSpecies = t->species;
+    m->attackerPersonality = a->personality;
+    m->targetPersonality = t->personality;
+    m->targetLevel = t->level;
+    m->targetType1 = t->type1;
+    m->targetType2 = t->type2;
+    m->battleTypeFlags = gBattleTypeFlags;
+    m->trainerId = (gBattleTypeFlags & BATTLE_TYPE_TRAINER) ? gTrainerBattleOpponent_A : 0;
+    m->trainerClass = (gBattleTypeFlags & BATTLE_TYPE_TRAINER) ? gTrainers[gTrainerBattleOpponent_A].trainerClass : 0;
+    m->verdict = CODE_RED_VANILLA;
+    m->reason = 0;
+    m->attackerStages = StageSum(a);
+    m->waited = 0;
+    m->calledSlot = (gHitMarker & HITMARKER_DISOBEDIENT_MOVE) ? sCalledSlot : 0;
+    m->state = 1; // publish last
+    sAsked = TRUE;
+    return TRUE;
+}
+
+// Finish Cmd_attackcanceler once the host has answered (or given up).
+void CodeRedMoveContinue(void)
+{
+    volatile struct CodeRedMove *m = &gCodeRedMove;
+    u8 verdict = CODE_RED_VANILLA;
+
+    switch (m->state)
+    {
+    case 1:
+        if (m->enabled && ++m->waited < CRM_WAIT_FRAMES)
+            return; // still writing
+        break;      // host gone or too slow: plain FireRed
+    case 2:
+        verdict = m->verdict;
+        break;
+    default:        // cancelled (state load / reset on the host side) or idle
+        break;
+    }
+    m->state = 0;
+    sAsked = FALSE;
+    if (verdict == CODE_RED_MISS)
+    {
+        CancelMultiTurnMoves(gBattlerAttacker);
+        gMoveResultFlags |= MOVE_RESULT_MISSED;
+        gLastLandedMoves[gBattlerTarget] = 0;
+        gLastHitByType[gBattlerTarget] = 0;
+        gBattleCommunication[MULTISTRING_CHOOSER] = m->reason < ARRAY_COUNT(gCodeRedMissStringIds) ? m->reason : 0;
+        gBattlescriptCurrInstr = BattleScript_CodeRedMoveMissed;
+    }
+    else
+    {
+        if (verdict == CODE_RED_HIT)
+            CodeRedPayloadShow(); // the move's bytes, if it made any (a sound, a picture)
+        gBattlescriptCurrInstr++;
+    }
+}
+
+// Doubt (owner, 2026-10-10). Only wild Pokémon pick their own moves; yours uses the move you call, unless its
+// instinct (System 1: the move that hits hardest now) disagrees. Then, with chance
+//     ½ × (1 − your call's score / its pick's score) × (8 − badges) / 8
+// it uses its own pick instead ("X doubted your call!"). The same rule in every battle, gyms included; it costs only
+// the move. Score = power × accuracy × type effectiveness × STAB (1.5), the same as rules/doubt.mjs instinctScore.
+static u32 TypeMultiplier(u8 moveType, u8 type1, u8 type2) // ×100
+{
+    u32 mult = 100, i;
+    for (i = 0; TYPE_EFFECT_ATK_TYPE(i) != TYPE_ENDTABLE; i += 3)
+    {
+        if (TYPE_EFFECT_ATK_TYPE(i) == TYPE_FORESIGHT || TYPE_EFFECT_ATK_TYPE(i) != moveType)
+            continue;
+        if (TYPE_EFFECT_DEF_TYPE(i) == type1)
+            mult = mult * TYPE_EFFECT_MULTIPLIER(i) / 10;
+        if (TYPE_EFFECT_DEF_TYPE(i) == type2 && type1 != type2)
+            mult = mult * TYPE_EFFECT_MULTIPLIER(i) / 10;
+    }
+    return mult;
+}
+
+static u32 InstinctScore(u16 move, struct BattlePokemon *a, struct BattlePokemon *t)
+{
+    const struct BattleMove *m = &gBattleMoves[move];
+    u32 score;
+    if (move == MOVE_NONE || m->power == 0)
+        return 0;
+    score = m->power * (m->accuracy ? m->accuracy : 100) * TypeMultiplier(m->type, t->type1, t->type2) / 100;
+    if (a->type1 == m->type || a->type2 == m->type)
+        score = score * 3 / 2;
+    return score;
+}
+
+static u8 BadgeCount(void)
+{
+    u8 n = 0, i;
+    for (i = 0; i < NUM_BADGES; i++)
+        if (FlagGet(FLAG_BADGE01_GET + i))
+            n++;
+    return n;
+}
+
+// From IsMonDisobedient (player side, before FireRed's traded-Pokémon check). TRUE = it uses its own pick: the
+// battle script is set to BattleScript_CodeRedDoubted, which prints the doubt and jumps to gCalledMove.
+bool8 CodeRedDoubts(void)
+{
+    struct BattlePokemon *a = &gBattleMons[gBattlerAttacker], *t = &gBattleMons[gBattlerTarget];
+    u8 unusable, badges, i, best = MAX_MON_MOVES;
+    u32 mine, top = 0, chance;
+
+    if (gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_SAFARI | BATTLE_TYPE_OLD_MAN_TUTORIAL))
+        return FALSE;
+    if (GetBattlerSide(gBattlerAttacker) != B_SIDE_PLAYER || gCurrMovePos >= MAX_MON_MOVES || a->moves[gCurrMovePos] != gCurrentMove)
+        return FALSE; // not your call (a called move, Struggle, a locked-in turn)
+    badges = BadgeCount();
+    if (badges >= NUM_BADGES)
+        return FALSE;
+    unusable = CheckMoveLimitations(gBattlerAttacker, 0, MOVE_LIMITATIONS_ALL);
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u32 score;
+        if ((1 << i) & unusable)
+            continue;
+        score = InstinctScore(a->moves[i], a, t);
+        if (score > top) { top = score; best = i; }
+    }
+    if (best == MAX_MON_MOVES || best == gCurrMovePos)
+        return FALSE;
+    mine = InstinctScore(gCurrentMove, a, t);
+    if (mine >= top)
+        return FALSE;
+    // chance out of 256: ½ × (top − mine) / top × (8 − badges) / 8
+    chance = (top - mine) * (NUM_BADGES - badges) * 128 / (top * NUM_BADGES);
+    if ((Random() & 0xFF) >= chance)
+        return FALSE;
+    sCalledSlot = gCurrMovePos + 1;
+    gCurrMovePos = gChosenMovePos = best;
+    gCalledMove = a->moves[best];
+    gBattlerTarget = GetMoveTarget(gCalledMove, NO_TARGET_OVERRIDE);
+    gHitMarker |= HITMARKER_DISOBEDIENT_MOVE;
+    gBattlescriptCurrInstr = BattleScript_CodeRedDoubted;
+    return TRUE;
+}
