@@ -0,0 +1,81 @@
+#include "global.h"
+#include "gflib.h"
+#include "task.h"
+#include "script.h"
+#include "string_util.h"
+#include "strings.h"
+#include "event_data.h"
+#include "constants/flags.h"
+#include "constants/menu.h"
+
+// Fixed 36-byte transport. No pointers, guest code or general emulator commands.
+struct CodeRedMailbox {
+    u32 magic;
+    u16 version;
+    u16 state;
+    u32 requestId;
+    u32 epoch;
+    u16 operation;
+    u16 status;
+    u16 stats[6];
+    u32 result;
+};
+STATIC_ASSERT(sizeof(struct CodeRedMailbox) == 36, CodeRedMailboxSize);
+EWRAM_DATA volatile struct CodeRedMailbox gCodeRedMailbox = {0};
+static EWRAM_DATA u32 sRequestId = 0;
+static const u8 sTimeout[] = _("Timed out");
+static const u8 sCancelled[] = _("Cancelled");
+static const u8 sConsoleClosed[] = _("Console closed");
+static const u8 sFailed[] = _("Runner error");
+
+static void Task_CodeRedWait(u8 taskId)
+{
+    if (gMain.newKeys & B_BUTTON) {
+        gCodeRedMailbox.state = 4;
+        StringCopy(gStringVar1, sCancelled);
+    } else if (++gTasks[taskId].data[0] >= 600) {
+        gCodeRedMailbox.state = 4;
+        StringCopy(gStringVar1, sTimeout);
+    } else if (gCodeRedMailbox.state == 2) {
+        if (gCodeRedMailbox.operation == 2 && gCodeRedMailbox.status == 2)
+            StringCopy(gStringVar1, sConsoleClosed);
+        else if (gCodeRedMailbox.status == 0 && gCodeRedMailbox.result <= 1530)
+            ConvertIntToDecimalStringN(gStringVar1, gCodeRedMailbox.result, STR_CONV_MODE_LEFT_ALIGN, 4);
+        else
+            StringCopy(gStringVar1, sFailed);
+    } else if (gCodeRedMailbox.state == 4) {
+        StringCopy(gStringVar1, sCancelled);
+    } else {
+        return;
+    }
+    gCodeRedMailbox.state = 0;
+    DestroyTask(taskId);
+    ScriptContext_Enable();
+}
+
+void CodeRedRunCalculation(void)
+{
+    static const u16 stats[6] = {45, 49, 49, 65, 65, 45};
+    u8 i;
+    gCodeRedMailbox.state = 0;
+    gCodeRedMailbox.magic = 0x31445243;
+    gCodeRedMailbox.version = 1;
+    gCodeRedMailbox.requestId = ++sRequestId;
+    gCodeRedMailbox.epoch = 0;
+    gCodeRedMailbox.operation = 2;
+    gCodeRedMailbox.status = 0;
+    for (i = 0; i < 6; i++) gCodeRedMailbox.stats[i] = stats[i];
+    gCodeRedMailbox.result = 0;
+    gCodeRedMailbox.state = 1;
+    CreateTask(Task_CodeRedWait, 8);
+}
+
+// Normalize only the new service-PC choices; original service IDs stay 0..3.
+void CodeRedMapPCChoice(void)
+{
+    u16 codeChoice = FlagGet(FLAG_SYS_GAME_CLEAR) ? 4 : (FlagGet(FLAG_SYS_POKEDEX_GET) ? 3 : 2);
+    if (gSpecialVar_Result == codeChoice)
+        gSpecialVar_Result = 5;
+    else if (gSpecialVar_Result == codeChoice + 1)
+        gSpecialVar_Result = 4;
+}
