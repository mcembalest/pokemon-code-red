+        CopyWindowToVram(i, COPYWIN_GFX);
+    ScheduleBgCopyTilemapToVram(0);
+}
+
+static bool8 Eeg_DoGfxSetup(void)
+{
+    u8 taskId;
+    u16 n = PARTY_SIZE + TOTAL_BOXES_COUNT * IN_BOX_COUNT + 1;
+    switch (gMain.state)
+    {
+    case 0:
+        SetVBlankHBlankCallbacksToNull();
+        ClearScheduledBgCopiesToVram();
+        gMain.state++;
+        break;
+    case 1:
+        ScanlineEffect_Stop();
+        FreeAllSpritePalettes();
+        ResetPaletteFade();
+        ResetSpriteData();
+        ResetTasks();
+        gMain.state++;
+        break;
+    case 2:
+        Eeg_InitBgs();
+        gMain.state++;
+        break;
+    case 3:
+        sEeg->entries = Alloc(sizeof(struct EegEntry) * n);
+        sEeg->items = Alloc(sizeof(struct ListMenuItem) * n);
+        sEeg->names = Alloc(NAME_BYTES * n);
+        if (sEeg->entries == NULL || sEeg->items == NULL || sEeg->names == NULL)
+        {
+            MainCallback back = sEeg->savedCallback;
+            Eeg_Free();
+            SetMainCallback2(back);
+            return TRUE;
+        }
+        Eeg_BuildList();
+        Eeg_BuildTemplate();
+        gMain.state++;
+        break;
+    case 4:
+        Eeg_InitWindows();
+        gMain.state++;
+        break;
+    case 5:
+        taskId = CreateTask(Task_EegMain, 0);
+        gTasks[taskId].data[0] = ListMenuInit(&gMultiuseListMenuTemplate, 0, 0);
+        if (sEeg->count + 1 > sEeg->maxShowed)
+            sEeg->arrows = AddScrollIndicatorArrowPairParameterized(2, 36, 18, 102, sEeg->count + 1 - sEeg->maxShowed, 110, 110, &sEeg->scroll);
+        gMain.state++;
+        break;
+    case 6:
+        HelpSystem_Disable(); // L/R switch tabs here
+        BlendPalettes(PALETTES_ALL, 16, RGB_BLACK);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+        gMain.state++;
+        break;
+    default:
+        SetVBlankCallback(Eeg_VBlankCB);
+        SetMainCallback2(Eeg_MainCB);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void Eeg_Free(void)
+{
+    if (gCodeRedEeg != NULL)
+    {
+        gCodeRedEeg->open = 0;
+        gCodeRedEeg->state = 0;
+        Free((void *)gCodeRedEeg);
+        gCodeRedEeg = NULL;
+    }
+    if (sEeg != NULL)
+    {
+        if (sEeg->entries) Free(sEeg->entries);
+        if (sEeg->items) Free(sEeg->items);
+        if (sEeg->names) Free(sEeg->names);
+        Free(sEeg);
+        sEeg = NULL;
+    }
+    FreeAllWindowBuffers();
+}
+
+// ---------------------------------------------------------------- tasks
+
+// Every frame the lobes breathe; every other frame the channels scroll one sample.
+static void Eeg_Animate(void)
+{
+    sEeg->phase++;
+    if ((sEeg->phase & 1) == 0)
+        Eeg_DrawTraces();
+    if (!gPaletteFade.active) // a fade owns the palettes
+        Eeg_PulseLobes();
+}
+
+static void Task_EegMain(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    s32 input;
+    Eeg_PollMind();
+    Eeg_Animate();
+    if (gPaletteFade.active)
+        return;
+    if (JOY_NEW(DPAD_LEFT | DPAD_RIGHT | L_BUTTON | R_BUTTON) && sEeg->current != 0xFFFF)
+    {
+        PlaySE(SE_SELECT);
+        sEeg->tab = (sEeg->tab + (JOY_NEW(DPAD_RIGHT | R_BUTTON) ? 1 : TAB_COUNT - 1)) % TAB_COUNT;
+        Eeg_PrintMind();
+        return;
+    }
+    input = ListMenu_ProcessInput(data[0]);
+    ListMenuGetScrollAndRow(data[0], &sEeg->scroll, &sEeg->row);
+    switch (input)
+    {
+    case LIST_NOTHING_CHOSEN:
+        break;
+    case LIST_CANCEL:
+        PlaySE(SE_SELECT);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+        gTasks[taskId].func = Task_EegTurnOff;
+        break;
+    default: // A: go to the NOTE tab; A again (or A on it) writes the note on the page
+        PlaySE(SE_SELECT);
+        data[1] = input;
+        if (sEeg->tab != TAB_NOTE)
+        {
+            sEeg->tab = TAB_NOTE;
+            Eeg_PrintMind();
+            break;
+        }
+        FillWindowPixelBuffer(WIN_MIND, PIXEL_FILL(C_CLEAR));
+        Eeg_PrintTabs();
+        Eeg_PrintBody(sText_EditHot);
+        CopyWindowToVram(WIN_MIND, COPYWIN_GFX);
+        Eeg_Ask(2, &sEeg->entries[data[1]]);
+        gTasks[taskId].func = Task_EegEditHot;
+        break;
+    }
+}
+
+static void Task_EegEditHot(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    bool8 done = FALSE;
+    Eeg_Animate();
+    if (JOY_NEW(B_BUTTON))
+    {
+        gCodeRedEeg->state = 4;
+        done = TRUE;
+    }
+    else if (gCodeRedEeg->state == 2 || gCodeRedEeg->state == 4 || ++sEeg->waited >= EEG_EDIT_FRAMES)
+        done = TRUE;
+    if (!done)
+        return;
+    gCodeRedEeg->state = 0;
+    PlaySE(SE_SELECT);
+    // Show the mind again, with whatever note the page kept.
+    sEeg->shownId = 0xFFFFFFFF;
+    sEeg->haveMind = FALSE;
+    Eeg_Ask(1, &sEeg->entries[data[1]]);
+    Eeg_PrintMind();
+    gTasks[taskId].func = Task_EegMain;
+}
+
+static void Task_EegTurnOff(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    Eeg_Animate();
+    if (!gPaletteFade.active)
+    {
+        DestroyListMenuTask(data[0], &sEeg->scroll, &sEeg->row);
+        if (sEeg->arrows != 0xFF)
+            RemoveScrollIndicatorArrowPair(sEeg->arrows);
+        HelpSystem_Enable();
+        SetMainCallback2(sEeg->savedCallback);
+        Eeg_Free();
+        DestroyTask(taskId);
+    }
+}
+
+// ---------------------------------------------------------------- from the PC script: special CodeRedPokeeg / waitstate
+
+static void Task_EegLaunch(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        CleanupOverworldWindowsAndTilemaps();
+        Eeg_Init(CB2_ReturnToFieldContinueScript);
+        DestroyTask(taskId);
+    }
+}
+
+void CodeRedPokeeg(void)
+{
+    FadeScreen(FADE_TO_BLACK, 0);
+    CreateTask(Task_EegLaunch, 0);
+}
