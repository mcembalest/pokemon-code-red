+// ---------------------------------------------------------------- screen setup / teardown
+
+static void Eeg_MainCB(void)
+{
+    RunTasks();
+    AnimateSprites();
+    BuildOamBuffer();
+    DoScheduledBgTilemapCopiesToVram();
+    UpdatePaletteFade();
+}
+
+static void Eeg_VBlankCB(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
+
+static void Eeg_Init(MainCallback callback)
+{
+    sEeg = Alloc(sizeof(struct EegState));
+    if (sEeg == NULL) { SetMainCallback2(callback); return; }
+    memset(sEeg, 0, sizeof(*sEeg));
+    sEeg->savedCallback = callback;
+    sEeg->arrows = 0xFF;
+    sEeg->subWindow = 0xFF;
+    sEeg->shownId = 0xFFFFFFFF;
+    SetMainCallback2(Eeg_RunSetup);
+}
+
+static void Eeg_RunSetup(void)
+{
+    while (1)
+    {
+        if (Eeg_DoGfxSetup() == TRUE)
+            break;
+        if (MenuHelpers_IsLinkActive() == TRUE)
+            break;
+    }
+}
+
+static bool8 Eeg_InitBgs(void)
+{
+    ResetAllBgsCoordinatesAndBgCntRegs();
+    sEegBg1Tilemap = Alloc(0x800);
+    if (sEegBg1Tilemap == NULL)
+        return FALSE;
+    memset(sEegBg1Tilemap, 0, 0x800);
+    ResetBgsAndClearDma3BusyFlags(0);
+    InitBgsFromTemplates(0, sBgTemplates, NELEMS(sBgTemplates));
+    SetBgTilemapBuffer(1, sEegBg1Tilemap);
+    ScheduleBgCopyTilemapToVram(1);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_OBJ_1D_MAP | DISPCNT_OBJ_ON);
+    SetGpuReg(REG_OFFSET_BLDCNT, 0);
+    ShowBg(0);
+    ShowBg(1);
+    return TRUE;
+}
+
+static bool8 Eeg_LoadGraphics(void)
+{
+    switch (sEeg->gfxStep)
+    {
+    case 0:
+        ResetTempTileDataBuffers();
+        DecompressAndCopyTileDataToVram(1, gItemPcTiles, 0, 0, 0);
+        sEeg->gfxStep++;
+        break;
+    case 1:
+        if (FreeTempTileDataBuffersIfPossible() != TRUE)
+        {
+            LZDecompressWram(gItemPcTilemap, sEegBg1Tilemap);
+            sEeg->gfxStep++;
+        }
+        break;
+    default:
+        LoadCompressedPalette(gItemPcBgPals, BG_PLTT_ID(0), 3 * PLTT_SIZE_4BPP);
+        sEeg->gfxStep = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void Eeg_InitWindows(void)
+{
+    u8 i;
+    InitWindows(sWindowTemplates);
+    DeactivateAllTextPrinters();
+    LoadUserWindowGfx(0, 0x3C0, BG_PLTT_ID(14));
+    LoadStdWindowGfx(0, 0x3A3, BG_PLTT_ID(12));
+    LoadMenuMessageWindowGfx(0, 0x3AC, BG_PLTT_ID(11));
+    LoadPalette(GetTextWindowPalette(2), BG_PLTT_ID(13), PLTT_SIZE_4BPP);
+    LoadPalette(gStandardMenuPalette, BG_PLTT_ID(15), PLTT_SIZE_4BPP);
+    for (i = 0; i < 3; i++)
+    {
+        FillWindowPixelBuffer(i, 0x00);
+        PutWindowTilemap(i);
+    }
+    ScheduleBgCopyTilemapToVram(0);
+}
+
+static bool8 Eeg_DoGfxSetup(void)
+{
+    u8 taskId;
+    u16 n = PARTY_SIZE + TOTAL_BOXES_COUNT * IN_BOX_COUNT + 1;
+    switch (gMain.state)
+    {
+    case 0:
+        SetVBlankHBlankCallbacksToNull();
+        ClearScheduledBgCopiesToVram();
+        gMain.state++;
+        break;
+    case 1:
+        ScanlineEffect_Stop();
+        FreeAllSpritePalettes();
+        ResetPaletteFade();
+        ResetSpriteData();
+        ResetTasks();
+        gMain.state++;
+        break;
+    case 2:
+        if (Eeg_InitBgs())
+            gMain.state++;
+        else
+        {
+            Eeg_Free();
+            SetMainCallback2(sEeg->savedCallback);
+            return TRUE;
+        }
+        break;
+    case 3:
+        if (Eeg_LoadGraphics() == TRUE)
+            gMain.state++;
+        break;
+    case 4:
+        Eeg_InitWindows();
+        gMain.state++;
+        break;
+    case 5:
+        sEeg->entries = Alloc(sizeof(struct EegEntry) * n);
+        sEeg->items = Alloc(sizeof(struct ListMenuItem) * n);
+        sEeg->names = Alloc(NAME_BYTES * n);
+        if (sEeg->entries == NULL || sEeg->items == NULL || sEeg->names == NULL)
+        {
+            Eeg_Free();
+            SetMainCallback2(sEeg->savedCallback);
+            return TRUE;
+        }
+        Eeg_BuildList();
+        Eeg_BuildTemplate();
+        gMain.state++;
+        break;
+    case 6:
+        Eeg_Print(WIN_TITLE, FONT_SMALL, sText_Title, 0, 1, 0);
+        taskId = CreateTask(Task_EegMain, 0);
+        gTasks[taskId].data[0] = ListMenuInit(&gMultiuseListMenuTemplate, 0, 0);
+        if (sEeg->count + 1 > sEeg->maxShowed)
+            sEeg->arrows = AddScrollIndicatorArrowPairParameterized(2, 128, 8, 104, sEeg->count + 1 - sEeg->maxShowed, 110, 110, &sEeg->scroll);
+        gMain.state++;
+        break;
+    case 7:
+        SetHelpContext(HELPCONTEXT_PLAYERS_PC_ITEMS);
+        BlendPalettes(PALETTES_ALL, 16, RGB_BLACK);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+        gMain.state++;
+        break;
+    default:
+        SetVBlankCallback(Eeg_VBlankCB);
+        SetMainCallback2(Eeg_MainCB);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void Eeg_Free(void)
+{
+    gCodeRedEeg.open = 0;
+    gCodeRedEeg.state = 0;
+    if (sEeg != NULL)
+    {
+        if (sEeg->entries) Free(sEeg->entries);
+        if (sEeg->items) Free(sEeg->items);
+        if (sEeg->names) Free(sEeg->names);
+        Free(sEeg);
+        sEeg = NULL;
+    }
+    if (sEegBg1Tilemap) { Free(sEegBg1Tilemap); sEegBg1Tilemap = NULL; }
+    FreeAllWindowBuffers();
+}
+
+// ---------------------------------------------------------------- tasks
+
+static void Task_EegMain(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    s32 input;
+    Eeg_PollMind();
+    if (gPaletteFade.active)
+        return;
+    input = ListMenu_ProcessInput(data[0]);
+    ListMenuGetScrollAndRow(data[0], &sEeg->scroll, &sEeg->row);
+    switch (input)
+    {
+    case LIST_NOTHING_CHOSEN:
+        break;
+    case LIST_CANCEL:
+        PlaySE(SE_SELECT);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+        gTasks[taskId].func = Task_EegTurnOff;
+        break;
+    default:
+        PlaySE(SE_SELECT);
+        data[1] = input;
+        sEeg->subWindow = AddWindow(&sSubmenuTemplate);
+        DrawStdFrameWithCustomTileAndPalette(sEeg->subWindow, FALSE, 0x3C0, 14);
+        PrintTextArray(sEeg->subWindow, FONT_NORMAL, 8, 2, GetFontAttribute(FONT_NORMAL, FONTATTR_MAX_LETTER_HEIGHT) + 2, 2, sSubmenuOptions);
+        Menu_InitCursor(sEeg->subWindow, FONT_NORMAL, 0, 2, GetFontAttribute(FONT_NORMAL, FONTATTR_MAX_LETTER_HEIGHT) + 2, 2, 0);
+        ScheduleBgCopyTilemapToVram(0);
+        gTasks[taskId].func = Task_EegSubmenu;
+        break;
+    }
+}
+
+static void Eeg_CloseSubmenu(void)
+{
+    ClearStdWindowAndFrameToTransparent(sEeg->subWindow, FALSE);
+    ClearWindowTilemap(sEeg->subWindow);
+    RemoveWindow(sEeg->subWindow);
+    sEeg->subWindow = 0xFF;
+    ScheduleBgCopyTilemapToVram(0);
+}
+
+static void Task_EegSubmenu(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    s8 input = Menu_ProcessInputNoWrapAround();
+    Eeg_PollMind();
+    switch (input)
+    {
+    case MENU_NOTHING_CHOSEN:
+        break;
+    case MENU_B_PRESSED:
+    case 1:
+        PlaySE(SE_SELECT);
+        Eeg_CloseSubmenu();
+        gTasks[taskId].func = Task_EegMain;
+        break;
+    case 0:
+        PlaySE(SE_SELECT);
+        Eeg_CloseSubmenu();
+        FillWindowPixelBuffer(WIN_MIND, 0);
+        Eeg_Print(WIN_MIND, FONT_NORMAL, sText_EditHot, 2, 3, MIND_COLOR);
+        CopyWindowToVram(WIN_MIND, COPYWIN_GFX);
+        Eeg_Ask(2, &sEeg->entries[data[1]]);
+        gTasks[taskId].func = Task_EegEditHot;
+        break;
+    }
+}
+
+static void Task_EegEditHot(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    bool8 done = FALSE;
+    if (JOY_NEW(B_BUTTON))
+    {
+        gCodeRedEeg.state = 4;
+        done = TRUE;
+    }
+    else if (gCodeRedEeg.state == 2 || gCodeRedEeg.state == 4 || ++sEeg->waited >= EEG_EDIT_FRAMES)
+        done = TRUE;
+    if (!done)
+        return;
+    gCodeRedEeg.state = 0;
+    PlaySE(SE_SELECT);
+    // Show the mind again, with whatever note the page kept.
+    sEeg->shownId = 0xFFFFFFFF;
+    FillWindowPixelBuffer(WIN_MIND, 0);
+    Eeg_Print(WIN_MIND, FONT_NORMAL, sText_Asking, 2, 3, MIND_COLOR);
+    CopyWindowToVram(WIN_MIND, COPYWIN_GFX);
+    Eeg_Ask(1, &sEeg->entries[data[1]]);
+    gTasks[taskId].func = Task_EegMain;
+}
+
+static void Task_EegTurnOff(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    if (!gPaletteFade.active)
+    {
+        DestroyListMenuTask(data[0], &sEeg->scroll, &sEeg->row);
+        if (sEeg->arrows != 0xFF)
+            RemoveScrollIndicatorArrowPair(sEeg->arrows);
+        SetMainCallback2(sEeg->savedCallback);
+        Eeg_Free();
+        DestroyTask(taskId);
+    }
+}
+
+// ---------------------------------------------------------------- from the PC script: special CodeRedPokeeg / waitstate
+
+static void Task_EegLaunch(u8 taskId)
+{
+    if (!gPaletteFade.active)
+    {
+        CleanupOverworldWindowsAndTilemaps();
+        Eeg_Init(CB2_ReturnToFieldContinueScript);
+        DestroyTask(taskId);
+    }
+}
+
+void CodeRedPokeeg(void)
+{
+    FadeScreen(FADE_TO_BLACK, 0);
+    CreateTask(Task_EegLaunch, 0);
+}
