+// ---------------------------------------------------------------- pixels
+
+static void Eeg_Pixel(u8 windowId, s32 x, s32 y, u8 color)
+{
+    u8 *p;
+    u32 w = gWindows[windowId].window.width;
+    if (x < 0 || y < 0 || x >= (s32)(w * 8) || y >= gWindows[windowId].window.height * 8)
+        return;
+    p = gWindows[windowId].tileData + ((y >> 3) * w + (x >> 3)) * 32 + (y & 7) * 4 + ((x & 7) >> 1);
+    *p = (x & 1) ? ((*p & 0x0F) | (color << 4)) : ((*p & 0xF0) | color);
+}
+
+// Rows y0 … y1 − 1 across the whole window, one u32 (a tile's row of 8 pixels) at a time: FillWindowPixelRect goes
+// pixel by pixel, too slow for 60 redraws a second.
+static void Eeg_FillRows(u8 windowId, u32 y0, u32 y1, u8 color)
+{
+    u32 w = gWindows[windowId].window.width, fill = color * 0x11111111, y, t;
+    u32 *rows = (u32 *)gWindows[windowId].tileData;
+    for (y = y0; y < y1; y++)
+        for (t = 0; t < w; t++)
+            rows[((y >> 3) * w + t) * 8 + (y & 7)] = fill;
+}
+
+static void Eeg_Square(u8 windowId, s32 x, s32 y, u8 color) // 3 × 3 around (x, y)
+{
+    s32 i, j;
+    for (j = -1; j <= 1; j++)
+        for (i = -1; i <= 1; i++)
+            Eeg_Pixel(windowId, x + i, y + j, color);
+}
+
+// ---------------------------------------------------------------- the brain
+
+// Two hemispheres either side of a one-pixel fissure.
+static bool8 InBrain(s32 x, s32 y)
+{
+    s32 hx = x > 0 ? 14 : -14;
+    if (x == 0)
+        return FALSE;
+    // ((x − hx) / 14.5)² + (y / 27)² ≤ 1, times 4 · 14.5² · 27²
+    return 4 * (x - hx) * (x - hx) * 729 + y * y * 841 <= 841 * 729;
+}
+
+// Drawn once: the geometry never changes, only the lobes' colors (palette) and the electrodes.
+static void Eeg_DrawBrain(void)
+{
+    s32 x, y, i, d, best, lobe, ox, oy, err;
+    FillWindowPixelBuffer(WIN_HEAD, PIXEL_FILL(H_PANEL));
+    for (y = -29; y <= 29; y++)
+        for (x = -31; x <= 31; x++)
+        {
+            u8 color, core, halo;
+            if (!InBrain(x, y))
+                continue;
+            best = 0x7FFFFFFF; lobe = 0;
+            for (i = 0; i < NUM_STATS_SHOWN - 1; i++)
+            {
+                // ((x − lx) / 1.1)² + (y − ly)², times 121
+                d = (x - sLobes[i].x) * (x - sLobes[i].x) * 100 + (y - sLobes[i].y) * (y - sLobes[i].y) * 121;
+                if (d < best) { best = d; lobe = i; }
+            }
+            core = H_LOBE0 + lobe * 2; halo = core + 1;
+            if (best < 3660)              // 5.5²
+                color = core;
+            else if (best < 7744)         // 8²
+                color = ((x + y) & 1) ? halo : core;
+            else if (best < 14641)        // 11²
+                color = halo;
+            else
+                color = ((x + y) & 1) ? H_PANEL : halo;
+            Eeg_Pixel(WIN_HEAD, HEAD_CX + x, HEAD_CY + y, color);
+        }
+    // folds over the glow, and the fissure
+    for (y = -27; y <= 27; y += 4)
+        for (x = -30; x <= 30; x++)
+        {
+            s32 v = gSineTable[(x * 37 + y * 41) & 0xFF], yy = y + (v * 3 + (v >= 0 ? 256 : -256)) / 512;
+            if (((x * 7 + y * 13) & 7) && InBrain(x, yy))
+                Eeg_Pixel(WIN_HEAD, HEAD_CX + x, HEAD_CY + yy, H_PANEL);
+        }
+    for (y = -28; y <= 28; y++)
+        Eeg_Pixel(WIN_HEAD, HEAD_CX, HEAD_CY + y, H_PANEL);
+    // the skull (midpoint circle), the nose, the ears
+    ox = SKULL_R; oy = 0; err = 1 - SKULL_R;
+    while (ox >= oy)
+    {
+        Eeg_Pixel(WIN_HEAD, HEAD_CX + ox, HEAD_CY + oy, H_SKULL); Eeg_Pixel(WIN_HEAD, HEAD_CX - ox, HEAD_CY + oy, H_SKULL);
+        Eeg_Pixel(WIN_HEAD, HEAD_CX + ox, HEAD_CY - oy, H_SKULL); Eeg_Pixel(WIN_HEAD, HEAD_CX - ox, HEAD_CY - oy, H_SKULL);
+        Eeg_Pixel(WIN_HEAD, HEAD_CX + oy, HEAD_CY + ox, H_SKULL); Eeg_Pixel(WIN_HEAD, HEAD_CX - oy, HEAD_CY + ox, H_SKULL);
+        Eeg_Pixel(WIN_HEAD, HEAD_CX + oy, HEAD_CY - ox, H_SKULL); Eeg_Pixel(WIN_HEAD, HEAD_CX - oy, HEAD_CY - ox, H_SKULL);
+        oy++;
+        if (err < 0) err += 2 * oy + 1;
+        else { ox--; err += 2 * (oy - ox) + 1; }
+    }
+    for (i = -3; i <= 3; i++)
+        Eeg_Pixel(WIN_HEAD, HEAD_CX + i, HEAD_CY - SKULL_R - 3 + (i < 0 ? -i : i), H_SKULL);
+    for (i = -4; i <= 4; i++)
+    {
+        Eeg_Pixel(WIN_HEAD, HEAD_CX - SKULL_R - 2 + (i < 0 ? -i : i) / 2, HEAD_CY + i, H_SKULL);
+        Eeg_Pixel(WIN_HEAD, HEAD_CX + SKULL_R + 2 - (i < 0 ? -i : i) / 2, HEAD_CY + i, H_SKULL);
+    }
+}
