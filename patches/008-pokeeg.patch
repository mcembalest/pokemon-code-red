+static bool8 Eeg_LoadGraphics(void)
+{
+    switch (sEeg->gfxStep)
+    {
+    case 0:
+        ResetTempTileDataBuffers();
+        DecompressAndCopyTileDataToVram(1, gItemPcTiles, 0, 0, 0);
+        sEeg->gfxStep++;
+        break;
+    case 1:
+        if (FreeTempTileDataBuffersIfPossible() != TRUE)
+        {
+            LZDecompressWram(gItemPcTilemap, sEegBg1Tilemap);
+            sEeg->gfxStep++;
+        }
+        break;
+    default:
+        LoadCompressedPalette(gItemPcBgPals, BG_PLTT_ID(0), 3 * PLTT_SIZE_4BPP);
+        sEeg->gfxStep = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
