+    { .bg = 0, .charBaseIndex = 0, .mapBaseIndex = 31, .priority = 0 },
+    { .bg = 1, .charBaseIndex = 3, .mapBaseIndex = 30, .priority = 1 },
+};
+enum { WIN_LIST, WIN_MIND, WIN_TITLE, WIN_MSG, WIN_COUNT };
+static const struct WindowTemplate sWindowTemplates[] = {
+    [WIN_LIST]  = { .bg = 0, .tilemapLeft = 7, .tilemapTop = 1, .width = 19, .height = 12, .paletteNum = 15, .baseBlock = 0x02bf },
+    [WIN_MIND]  = { .bg = 0, .tilemapLeft = 5, .tilemapTop = 14, .width = 25, .height = 6, .paletteNum = 13, .baseBlock = 0x0229 },
+    [WIN_TITLE] = { .bg = 0, .tilemapLeft = 1, .tilemapTop = 1, .width = 5, .height = 4, .paletteNum = 15, .baseBlock = 0x0215 },
+    [WIN_MSG]   = { .bg = 0, .tilemapLeft = 2, .tilemapTop = 15, .width = 26, .height = 4, .paletteNum = 11, .baseBlock = 0x016f },
+    DUMMY_WIN_TEMPLATE
+};
+static const u8 sTextColors[][3] = {
+    {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_WHITE, TEXT_COLOR_DARK_GRAY},
+    {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_DARK_GRAY, TEXT_COLOR_LIGHT_GRAY},
+    {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_LIGHT_GRAY, TEXT_COLOR_DARK_GRAY},
+    {TEXT_COLOR_TRANSPARENT, TEXT_DYNAMIC_COLOR_1, TEXT_COLOR_DARK_GRAY}, // on the blue mind window
+};
