+static const u8 sText_Instinct[] = _("Instinct: whatever hits hardest.");
+static const u8 sText_Trusts[] = _("Trusts your picks: ");
+static const u8 sText_Percent[] = _("% (badges)");
+static const u8 sText_LR[] = _("{LEFT_ARROW}{RIGHT_ARROW}");
+static const u8 sText_System[] = _(" system");
+static const u8 sText_Arrives[] = _("Data arrives as: ");
+static const u8 sText_Learned[] = _("Learned: ");
+static const u8 sText_Dex[] = _("Pokédex: ");
+static const u8 sText_NoneYet[] = _("none yet");
+static const u8 sText_Budget[] = _("Budget: ");
+static const u8 sText_BytesATurn[] = _(" bytes a turn");
+static const u8 sText_LastTurns[] = _("Last ");
+static const u8 sText_Turns[] = _(" turns: ");
+static const u8 sText_HitN[] = _(" hit, ");
+static const u8 sText_MissN[] = _(" miss");
+static const u8 sText_NoCode[] = _("No code written yet.");
+static const u8 sText_NoNote[] = _("No note yet.\nPress A to write one.");
+static const u8 sText_ChangeNote[] = _("\nPress A to change it.");
+static const u8 sText_EditHot[] = _("Type its note on the page.\nB here cancels.");
