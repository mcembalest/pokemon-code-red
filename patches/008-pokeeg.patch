+    u16 waited;
+    u32 shownId;
+    u8 tab;       // 0 SYSTEM, 1 READERS, 2 CODE, 3 NOTE
+    bool8 haveMind; // the page answered for the Pokémon under the cursor
+};
+enum { TAB_SYSTEM, TAB_READERS, TAB_CODE, TAB_NOTE, TAB_INSTINCT, TAB_COUNT };
+static EWRAM_DATA struct EegState *sEeg = NULL;
+static EWRAM_DATA u8 *sEegBg1Tilemap = NULL;
