+#include "field_weather.h"
+#include "constants/field_weather.h"
+#include "constants/songs.h"
+
+// Fixed 164-byte transport. Host writes the reply fields; the game writes the request fields.
+struct CodeRedEeg {
+    /*0x00*/ u32 magic;        // 'CRE1'
+    /*0x04*/ u16 version;      // 1
+    /*0x06*/ u8 state;         // 0 idle, 1 request, 2 reply, 4 cancelled (game)
+    /*0x07*/ u8 op;            // 1 mind summary, 2 edit hot memory
+    /*0x08*/ u32 requestId;
+    /*0x0C*/ u32 epoch;
+    /*0x10*/ u32 personality;
+    /*0x14*/ u16 species;
+    /*0x16*/ u8 level;
+    /*0x17*/ u8 open;          // the screen is open (the page's panel follows the cursor)
+    // reply (host)
+    /*0x18*/ u8 readers;       // readers this Pokémon learned
+    /*0x19*/ u8 dex;           // Pokédex readers (shared)
+    /*0x1A*/ u16 budget;       // byte budget at its level
+    /*0x1C*/ u8 focus;         // ×100
+    /*0x1D*/ u8 nHistory;      // ≤ 10
+    /*0x1E*/ u8 history[10];   // 1 hit, 0 miss, oldest first
+    /*0x28*/ u8 format[24];    // game text, EOS-terminated: how its data arrives ("write log")
+    /*0x40*/ u8 hot[100];      // game text, EOS-terminated: hot memory
+};
+STATIC_ASSERT(sizeof(struct CodeRedEeg) == 164, CodeRedEegSize);
+EWRAM_DATA volatile struct CodeRedEeg gCodeRedEeg = {0};
+static EWRAM_DATA u32 sEegRequestId = 0;
+
+#define EEG_MAGIC 0x31455243
+#define EEG_WAIT_FRAMES 300
+#define EEG_EDIT_FRAMES 18000  // 5 minutes to type on the page
+#define NAME_BYTES 12
+
+struct EegEntry { u32 personality; u16 species; u8 level; u8 box; u8 slot; }; // box 0xFF = party
+
+struct EegState {
+    MainCallback savedCallback;
+    struct EegEntry *entries;
+    struct ListMenuItem *items;
+    u8 *names;
+    u16 count;
+    u16 scroll, row;
+    u16 maxShowed;
+    u8 arrows;
+    u8 gfxStep;
+    u8 subWindow;
+    u16 waited;
+    u32 shownId;
+};
+static EWRAM_DATA struct EegState *sEeg = NULL;
+static EWRAM_DATA u8 *sEegBg1Tilemap = NULL;
+
+static const struct BgTemplate sBgTemplates[2] = {
+    { .bg = 0, .charBaseIndex = 0, .mapBaseIndex = 31, .priority = 0 },
+    { .bg = 1, .charBaseIndex = 3, .mapBaseIndex = 30, .priority = 1 },
+};
+enum { WIN_LIST, WIN_MIND, WIN_TITLE, WIN_MSG, WIN_COUNT };
+static const struct WindowTemplate sWindowTemplates[] = {
+    [WIN_LIST]  = { .bg = 0, .tilemapLeft = 7, .tilemapTop = 1, .width = 19, .height = 12, .paletteNum = 15, .baseBlock = 0x02bf },
+    [WIN_MIND]  = { .bg = 0, .tilemapLeft = 5, .tilemapTop = 14, .width = 25, .height = 6, .paletteNum = 13, .baseBlock = 0x0229 },
+    [WIN_TITLE] = { .bg = 0, .tilemapLeft = 1, .tilemapTop = 1, .width = 5, .height = 4, .paletteNum = 15, .baseBlock = 0x0215 },
+    [WIN_MSG]   = { .bg = 0, .tilemapLeft = 2, .tilemapTop = 15, .width = 26, .height = 4, .paletteNum = 11, .baseBlock = 0x016f },
+    DUMMY_WIN_TEMPLATE
+};
+static const struct WindowTemplate sSubmenuTemplate = { .bg = 0, .tilemapLeft = 20, .tilemapTop = 9, .width = 9, .height = 4, .paletteNum = 15, .baseBlock = 0x0120 };
+static const u8 sTextColors[][3] = {
+    {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_WHITE, TEXT_COLOR_DARK_GRAY},
+    {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_DARK_GRAY, TEXT_COLOR_LIGHT_GRAY},
+    {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_LIGHT_GRAY, TEXT_COLOR_DARK_GRAY},
+    {TEXT_COLOR_TRANSPARENT, TEXT_DYNAMIC_COLOR_1, TEXT_COLOR_DARK_GRAY}, // on the blue mind window
+};
+#define MIND_COLOR 3
+
+static const u8 sText_Title[] = _("PokÉEG");
+static const u8 sText_Exit[] = _("EXIT");
+static const u8 sText_Party[] = _("P");
+static const u8 sText_Box[] = _("B");
+static const u8 sText_Asking[] = _("Reading its mind…");
+static const u8 sText_NoHost[] = _("Its mind is on the page: open\nCode Red in the browser.");
+static const u8 sText_ExitDesc[] = _("Back to the PC.");
+static const u8 sText_System[] = _(" system: ");
+static const u8 sText_Readers[] = _("readers ");
+static const u8 sText_Dex[] = _(" · Pokédex ");
+static const u8 sText_Budget[] = _(" · budget ");
+static const u8 sText_Last[] = _("last: ");
+static const u8 sText_None[] = _("nothing written yet");
+static const u8 sText_Note[] = _("note: ");
+static const u8 sText_NoNote[] = _("no hot memory (A to add)");
+static const u8 sText_Hit[] = _("o");
+static const u8 sText_Miss[] = _("x");
+static const u8 sText_EditHot[] = _("Type its note on the page.\nB here cancels.");
+static const u8 sText_HotMemory[] = _("Hot memory");
+static const struct MenuAction sSubmenuOptions[] = {
+    { sText_HotMemory, {.void_u8 = NULL} },
+    { gFameCheckerText_Cancel, {.void_u8 = NULL} },
+};
