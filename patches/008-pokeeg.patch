+static u32 sNoise;
+static s32 Noise(s32 amp) // −amp … amp, seeded by the Pokémon (the game's own RNG is left alone)
+{
+    sNoise = sNoise * 1103515245 + 12345;
+    return amp ? (s32)((sNoise >> 16) % (2 * amp + 1)) - amp : 0;
+}
