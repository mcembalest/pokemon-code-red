+static void Eeg_RunSetup(void)
+{
+    while (1)
+    {
+        if (Eeg_DoGfxSetup() == TRUE)
+            break;
+        if (MenuHelpers_IsLinkActive() == TRUE)
+            break;
+    }
+}
