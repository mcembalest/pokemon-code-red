+static void Eeg_InitWindows(void)
+{
+    u8 i;
+    static const u16 sBackdrop = RGB(1, 2, 4);
+    InitWindows(sWindowTemplates);
+    DeactivateAllTextPrinters();
+    LoadPalette(&sBackdrop, BG_PLTT_ID(0), sizeof(u16));
+    LoadPalette(sTextPal, BG_PLTT_ID(PAL_TEXT), PLTT_SIZE_4BPP);
+    LoadPalette(sHeadPal, BG_PLTT_ID(PAL_HEAD), PLTT_SIZE_4BPP);
+    for (i = 0; i < WIN_COUNT; i++)
+    {
+        FillWindowPixelBuffer(i, PIXEL_FILL(C_CLEAR));
+        PutWindowTilemap(i);
+    }
+    FillWindowPixelBuffer(WIN_TRACE, PIXEL_FILL(C_PANEL));
+    Eeg_DrawBrain();
+    Eeg_PulseLobes();
