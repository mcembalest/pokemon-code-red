+static s8 ClampTrace(s32 v) { return v > 5 ? 5 : v < -5 ? -5 : v; } // ±5 around the baseline: rows 11 … 21 of a channel (the label sits above)
+
+static void Eeg_WaveMemory(void)
+{
+    static const s8 sHit[] = { 0, 0, -1, 7, -3, 1, 0 }, sMiss[] = { 0, 0, 0, -2, -3, -2, 0 };
+    u32 i;
+    sNoise = sEeg->entries[sEeg->current].personality ^ 0x5EED;
+    for (i = 0; i < WAVE_LEN; i++)
+    {
+        u32 slot = i * 10 / WAVE_LEN, local = i - slot * WAVE_LEN / 10;
+        s32 v = 0;
+        if (sEeg->haveMind && slot < gCodeRedEeg->nHistory && local < sizeof(sHit))
+            v = gCodeRedEeg->history[slot] ? sHit[local] : sMiss[local];
+        sEeg->wave[CH_MEMORY][i] = ClampTrace(v + ((i & 3) == 0 ? Noise(sEeg->haveMind ? 0 : 1) : 0));
+    }
+}
+
+// Each channel is one loop of 128 samples, made from the Pokémon's own numbers:
+//   BOND: a slow wave, taller and steadier with friendship (low friendship: small and jittery).
+//   WIRING: six tones, one per IV, each as loud as the IV is high.
+//   TRAINING: six bursts, one per stat, each as tall as its EVs (none yet: a faint buzz).
+static void Eeg_Waves(void)
+{
+    static const u8 sTones[NUM_STATS_SHOWN] = { 2, 3, 5, 7, 11, 13 };
+    u32 i, k;
+    sNoise = sEeg->entries[sEeg->current].personality;
+    for (i = 0; i < WAVE_LEN; i++)
+    {
+        s32 amp = 2 + sEeg->friendship * 5 / 255, jitter = (255 - sEeg->friendship) * 4 / 255, sum = 0;
+        u32 block, local, env, evAmp;
+        sEeg->wave[CH_BOND][i] = ClampTrace(Sin(i * 8 & 0xFF, amp) + Noise(jitter));
+        for (k = 0; k < NUM_STATS_SHOWN; k++)
+            sum += gSineTable[(i * sTones[k] * 2 + k * 40) & 0xFF] * sEeg->ivs[k];
+        sEeg->wave[CH_WIRING][i] = ClampTrace(sum * 22 / (31 * 256 * 10));
+        block = i * NUM_STATS_SHOWN / WAVE_LEN;
+        local = i * NUM_STATS_SHOWN - block * WAVE_LEN; // 0 … 127 within the block
+        env = gSineTable[(local / 2) & 0xFF];          // half a sine: 0 → 256 → 0
+        evAmp = sEeg->evs[block] * 8 * 256 / 255;
+        if (evAmp < 320) evAmp = 320; // untrained: a faint buzz
+        sEeg->wave[CH_TRAINING][i] = ClampTrace((s32)(evAmp * env / 65536) * ((i >> 1) & 1 ? 1 : -1));
+    }
+    Eeg_WaveMemory();
+}
+
+static void Eeg_DrawLabels(void)
+{
+    u8 c;
+    for (c = 0; c < CHANNELS; c++)
+    {
+        Eeg_FillRows(WIN_TRACE, c * CH_H, c * CH_H + 10, C_PANEL);
+        Eeg_Print(WIN_TRACE, FONT_SMALL, sChannelNames[c], TRACE_X, c * CH_H, sEeg->tab == sChannelTab[c] ? TC_PANEL_TEXT : TC_PANEL_LABEL);
+    }
+}
+
+static void Eeg_DrawTraces(void)
+{
+    static const u8 sColors[CHANNELS] = { C_BOND, C_WIRING, C_TRAINING, C_MEMORY };
+    u8 c;
+    s32 x, y, prev, base, yy, lo, hi;
+    for (c = 0; c < CHANNELS; c++)
+    {
+        base = c * CH_H + 16;
+        Eeg_FillRows(WIN_TRACE, c * CH_H + 10, c * CH_H + CH_H, C_PANEL);
+        for (x = 3 - ((sEeg->phase / 2) & 3); x < TRACE_W; x += 4)
+            Eeg_Pixel(WIN_TRACE, TRACE_X + x, base, C_DIM);
+        if (sEeg->current == 0xFFFF)
+            continue; // EXIT: no signal
+        prev = 0x7FFF;
+        for (x = 0; x < TRACE_W; x++)
+        {
+            y = base - sEeg->wave[c][(x + sEeg->phase / 2) & (WAVE_LEN - 1)];
+            if (prev == 0x7FFF) prev = y;
+            lo = prev < y ? prev : y; hi = prev < y ? y : prev;
+            for (yy = lo; yy <= hi; yy++)
+                Eeg_Pixel(WIN_TRACE, TRACE_X + x, yy, sColors[c]);
+            prev = y;
+        }
+    }
+    CopyWindowToVram(WIN_TRACE, COPYWIN_GFX);
+}
+
+// ---------------------------------------------------------------- the list: party, then boxes
+
+static struct BoxPokemon *Eeg_Mon(const struct EegEntry *e)
+{
+    return e->box == 0xFF ? &gPlayerParty[e->slot].box : GetBoxedMonPtr(e->box, e->slot);
+}
+
+static void Eeg_AddEntry(struct BoxPokemon *mon, u8 box, u8 slot, u8 level)
+{
+    struct EegEntry *e;
+    u8 *name;
+    if (!GetBoxMonData(mon, MON_DATA_SANITY_HAS_SPECIES) || GetBoxMonData(mon, MON_DATA_SANITY_IS_EGG) || GetBoxMonData(mon, MON_DATA_SANITY_IS_BAD_EGG))
+        return;
+    e = &sEeg->entries[sEeg->count];
+    e->personality = GetBoxMonData(mon, MON_DATA_PERSONALITY);
+    e->species = GetBoxMonData(mon, MON_DATA_SPECIES);
+    e->level = level ? level : GetLevelFromBoxMonExp(mon);
+    e->box = box; e->slot = slot;
+    e->friendship = GetBoxMonData(mon, MON_DATA_FRIENDSHIP);
+    name = &sEeg->names[sEeg->count * NAME_BYTES];
+    GetBoxMonData(mon, MON_DATA_NICKNAME, name);
+    name[POKEMON_NAME_LENGTH] = EOS;
+    sEeg->items[sEeg->count].label = name;
+    sEeg->items[sEeg->count].index = sEeg->count;
+    sEeg->count++;
+}
+
+static void Eeg_BuildList(void)
+{
+    u8 i, b, s;
+    sEeg->count = 0;
+    for (i = 0; i < gPlayerPartyCount && i < PARTY_SIZE; i++)
+        Eeg_AddEntry(&gPlayerParty[i].box, 0xFF, i, GetMonData(&gPlayerParty[i], MON_DATA_LEVEL));
+    for (b = 0; b < TOTAL_BOXES_COUNT; b++)
+        for (s = 0; s < IN_BOX_COUNT; s++)
+            Eeg_AddEntry(GetBoxedMonPtr(b, s), b, s, 0);
+    sEeg->items[sEeg->count].label = sText_Exit;
+    sEeg->items[sEeg->count].index = LIST_CANCEL;
+    sEeg->maxShowed = sEeg->count + 1 < 5 ? sEeg->count + 1 : 5;
+}
+
+// What the game itself knows: nature, IVs, EVs, friendship.
+static void Eeg_ReadMon(const struct EegEntry *e)
+{
+    struct BoxPokemon *mon = Eeg_Mon(e);
+    u8 i;
+    sEeg->nature = e->personality % NUM_NATURES;
+    sEeg->friendship = e->friendship;
+    for (i = 0; i < NUM_STATS_SHOWN; i++)
+    {
+        sEeg->ivs[i] = GetBoxMonData(mon, MON_DATA_HP_IV + i);
+        sEeg->evs[i] = GetBoxMonData(mon, MON_DATA_HP_EV + i);
+    }
+}
+
+// ---------------------------------------------------------------- the mailbox
+
+static void Eeg_Ask(u8 op, const struct EegEntry *e)
+{
+    gCodeRedEeg->state = 0;
+    gCodeRedEeg->magic = EEG_MAGIC;
+    gCodeRedEeg->version = 3;
+    gCodeRedEeg->op = op;
+    gCodeRedEeg->requestId = ++sEegRequestId;
+    gCodeRedEeg->personality = e->personality;
+    gCodeRedEeg->species = e->species;
+    gCodeRedEeg->level = e->level;
+    gCodeRedEeg->open = 1;
+    gCodeRedEeg->state = 1; // publish last
+    sEeg->waited = 0;
+}
+
+// The title: PokÉEG, then the Pokémon under the cursor and where it lives.
+static void Eeg_PrintTitle(void)
+{
+    u8 *s;
+    const struct EegEntry *e;
+    FillWindowPixelBuffer(WIN_TITLE, PIXEL_FILL(C_CLEAR));
+    Eeg_Print(WIN_TITLE, FONT_NORMAL, sText_Title, 4, 1, TC_TEXT);
+    if (sEeg->current != 0xFFFF)
+    {
+        e = &sEeg->entries[sEeg->current];
+        s = StringCopy(gStringVar4, &sEeg->names[sEeg->current * NAME_BYTES]);
+        s = StringAppend(s, sText_Lv);
+        s = ConvertIntToDecimalStringN(s, e->level, STR_CONV_MODE_LEFT_ALIGN, 3);
+        *s++ = CHAR_SPACE; *s++ = CHAR_SPACE; *s = EOS;
+        if (e->box == 0xFF)
+            StringAppend(s, sText_Party);
+        else
+        {
+            s = StringAppend(s, sText_Box);
+            ConvertIntToDecimalStringN(s, e->box + 1, STR_CONV_MODE_LEFT_ALIGN, 2);
+        }
+        Eeg_Print(WIN_TITLE, FONT_SMALL, gStringVar4, 236 - GetStringWidth(FONT_SMALL, gStringVar4, 0), 3, TC_LABEL);
+    }
+    CopyWindowToVram(WIN_TITLE, COPYWIN_GFX);
+}
+
+// ◀ BOND ▶ and a dot per tab.
+static void Eeg_PrintTabs(void)
+{
+    u8 i, x;
+    u8 *s = StringCopy(gStringVar4, sText_Left);
+    s = StringAppend(s, sTabNames[sEeg->tab]);
+    StringAppend(s, sText_Right);
+    Eeg_Print(WIN_MIND, FONT_SMALL, gStringVar4, 4, 0, TC_TEXT);
+    x = 236 - TAB_COUNT * 6;
+    for (i = 0; i < TAB_COUNT; i++)
+        FillWindowPixelRect(WIN_MIND, PIXEL_FILL(i == sEeg->tab ? C_BRIGHT : C_DIM), x + i * 6, 4, 3, 3);
+}
+
+static void Eeg_PrintBody(const u8 *text)
+{
+    Eeg_Print(WIN_MIND, FONT_NORMAL, text, 4, 12, TC_TEXT);
+}
+
+/** Copy mailbox text (EOS-terminated, at most max bytes) to s; returns the new end. StringCopyN copies past EOS, so not that. */
+static u8 *Eeg_CopyText(u8 *s, const volatile u8 *text, u8 max)
+{
+    u8 i;
+    for (i = 0; i < max && text[i] != EOS; i++)
+        *s++ = text[i];
+    *s = EOS;
+    return s;
+}
+
+static u8 *Eeg_AppendOr(u8 *s, const volatile u8 *text, const u8 *fallback, u8 max)
+{
+    if (text[0] == EOS)
+        return StringAppend(s, fallback);
+    return Eeg_CopyText(s, text, max);
+}
+
+static u8 *Eeg_Num(u8 *s, u32 n) { return ConvertIntToDecimalStringN(s, n, STR_CONV_MODE_LEFT_ALIGN, 3); }
+
+// "HP 31  ATTACK 0  DEFENSE 15 \n SPEED 7  SP. ATK 20  SP. DEF 30"
+static u8 *Eeg_StatLines(u8 *s, const u8 *values)
+{
+    u8 i;
+    for (i = 0; i < NUM_STATS_SHOWN; i++)
+    {
+        if (i == 3) *s++ = CHAR_NEWLINE;
+        else if (i) { *s++ = CHAR_SPACE; *s++ = CHAR_SPACE; }
+        s = StringCopy(s, sStatNames[i]);
+        *s++ = CHAR_SPACE;
+        s = Eeg_Num(s, values[i]);
+    }
+    return s;
+}
+
+static void Eeg_PrintMind(void)
+{
+    u8 *s = gStringVar4;
+    u8 i, hits = 0, up, down;
+    u32 total;
+    FillWindowPixelBuffer(WIN_MIND, PIXEL_FILL(C_CLEAR));
+    Eeg_DrawLabels();
+    if (sEeg->current == 0xFFFF)
+    {
+        Eeg_PrintBody(sText_ExitDesc);
+        CopyWindowToVram(WIN_MIND, COPYWIN_GFX);
+        return;
+    }
+    Eeg_PrintTabs();
+    if (sEeg->tab >= TAB_CODE && !sEeg->haveMind)
+    {
+        Eeg_PrintBody(gCodeRedEeg->state == 1 && gCodeRedEeg->op == 1 ? sText_Asking : sText_NoHost);
+        CopyWindowToVram(WIN_MIND, COPYWIN_GFX);
+        return;
+    }
+    switch (sEeg->tab)
+    {
+    case TAB_NATURE: // ADAMANT nature \n Raises ATTACK: its lobe glows. \n Lowers SP. ATK: its lobe dims.
+        s = StringCopy(gStringVar4, gNatureNamePointers[sEeg->nature]);
+        s = StringAppend(s, sText_NatureN);
+        *s++ = CHAR_NEWLINE;
+        up = NATURE_UP(sEeg->nature); down = NATURE_DOWN(sEeg->nature);
+        if (up == down)
+        {
+            StringCopy(s, sText_Balanced);
+            break;
+        }
+        s = StringCopy(s, sText_Raises);
+        s = StringAppend(s, sStatNames[1 + up]);
+        s = StringAppend(s, sText_ItsLobeGlows);
+        *s++ = CHAR_NEWLINE;
+        s = StringCopy(s, sText_Lowers);
+        s = StringAppend(s, sStatNames[1 + down]);
+        StringAppend(s, sText_ItsLobeDims);
+        break;
+    case TAB_WIRING:
+        s = StringCopy(gStringVar4, sText_WiringHead);
+        *s++ = CHAR_NEWLINE;
+        Eeg_StatLines(s, sEeg->ivs);
+        break;
+    case TAB_TRAINING:
+        for (total = 0, i = 0; i < NUM_STATS_SHOWN; i++) total += sEeg->evs[i];
+        s = StringCopy(gStringVar4, sText_TrainingHead);
+        s = Eeg_Num(s, total);
+        s = StringAppend(s, sText_Of510);
+        *s++ = CHAR_NEWLINE;
+        Eeg_StatLines(s, sEeg->evs);
+        break;
+    case TAB_BOND: // Friendship: 70 of 255 \n Instinct: whatever hits hardest. \n Doubts your calls: up to 36%
+    {
+        // rules/doubt.mjs maxDoubt: 50% × (255 − friendship) / 255, rounded
+        u8 doubtMax = (50 * (MAX_FRIENDSHIP - sEeg->friendship) + MAX_FRIENDSHIP / 2) / MAX_FRIENDSHIP;
+        s = StringCopy(gStringVar4, sText_Friendship);
+        s = Eeg_Num(s, sEeg->friendship);
+        s = StringAppend(s, sText_Of255);
+        *s++ = CHAR_NEWLINE;
+        s = StringCopy(s, sText_Instinct);
+        *s++ = CHAR_NEWLINE;
+        if (doubtMax == 0)
+        {
+            StringCopy(s, sText_NeverDoubts);
+            break;
+        }
+        s = StringCopy(s, sText_Doubts);
+        s = Eeg_Num(s, doubtMax);
+        StringCopy(s, sText_Percent);
+        break;
+    }
+    case TAB_CODE: // FIRE system \n Data arrives as: write log \n Budget: 350 bytes a turn
+        s = StringCopy(gStringVar4, gTypeNames[gSpeciesInfo[gCodeRedEeg->species].types[0]]);
+        s = StringAppend(s, sText_System);
+        *s++ = CHAR_NEWLINE;
+        s = StringCopy(s, sText_Arrives);
+        s = Eeg_AppendOr(s, gCodeRedEeg->format, sText_NoneYet, 23);
+        *s++ = CHAR_NEWLINE;
+        s = StringCopy(s, sText_Budget);
+        s = ConvertIntToDecimalStringN(s, gCodeRedEeg->budget, STR_CONV_MODE_LEFT_ALIGN, 4);
+        StringAppend(s, sText_BytesATurn);
+        break;
+    case TAB_MEMORY: // Learned: Water, Rock \n Pokédex: Normal, Rock \n Last 5 turns: 4 hit, 1 miss
+        s = StringCopy(gStringVar4, sText_Learned);
+        s = Eeg_AppendOr(s, gCodeRedEeg->readersText, sText_NoneYet, 47);
+        *s++ = CHAR_NEWLINE;
+        s = StringCopy(s, sText_Dex);
+        s = Eeg_AppendOr(s, gCodeRedEeg->dexText, sText_NoneYet, 47);
+        *s++ = CHAR_NEWLINE;
+        if (gCodeRedEeg->nHistory == 0)
+            StringCopy(s, sText_NoCode);
+        else
+        {
+            for (i = 0; i < gCodeRedEeg->nHistory && i < 10; i++) hits += gCodeRedEeg->history[i] ? 1 : 0;
+            s = StringCopy(s, sText_LastTurns);
+            s = ConvertIntToDecimalStringN(s, gCodeRedEeg->nHistory, STR_CONV_MODE_LEFT_ALIGN, 2);
+            s = StringAppend(s, sText_Turns);
+            s = ConvertIntToDecimalStringN(s, hits, STR_CONV_MODE_LEFT_ALIGN, 2);
+            s = StringAppend(s, sText_HitN);
+            s = ConvertIntToDecimalStringN(s, gCodeRedEeg->nHistory - hits, STR_CONV_MODE_LEFT_ALIGN, 2);
+            StringAppend(s, sText_MissN);
+        }
+        break;
+    default: // the note itself (the page wraps it onto two lines), or how to write one
+        if (gCodeRedEeg->hot[0] == EOS)
+            StringCopy(gStringVar4, sText_NoNote);
+        else
+        {
+            s = Eeg_CopyText(gStringVar4, gCodeRedEeg->hot, 99);
+            for (i = 0; gStringVar4[i] != EOS; i++)
+                if (gStringVar4[i] == CHAR_NEWLINE) break;
+            if (gStringVar4[i] == EOS) // a one-line note leaves room for the hint
+                StringAppend(s, sText_ChangeNote);
+        }
+        break;
+    }
+    Eeg_PrintBody(gStringVar4);
+    CopyWindowToVram(WIN_MIND, COPYWIN_GFX);
+}
+
+static void Eeg_PollMind(void)
+{
+    if (sEeg->shownId == gCodeRedEeg->requestId || gCodeRedEeg->op != 1)
+        return;
+    if (gCodeRedEeg->state == 2)
+    {
+        sEeg->shownId = gCodeRedEeg->requestId;
+        gCodeRedEeg->state = 0;
+        sEeg->haveMind = TRUE;
+        Eeg_WaveMemory();
+        Eeg_PrintMind();
+    }
+    else if (gCodeRedEeg->state == 1 && ++sEeg->waited == EEG_WAIT_FRAMES)
+    {
+        sEeg->shownId = gCodeRedEeg->requestId;
+        gCodeRedEeg->state = 0;
+        sEeg->haveMind = FALSE;
+        Eeg_PrintMind();
+    }
+}
