+// The lobes breathe: each lobe's two colors follow a slow sine. Its nature's raised stat glows bright, the
+// lowered one stays dim, the rest in between. Nothing under the cursor (EXIT): all dim.
+static void Eeg_PulseLobes(void)
+{
+    u16 colors[10];
+    u8 i, up = NATURE_UP(sEeg->nature), down = NATURE_DOWN(sEeg->nature);
+    for (i = 0; i < NUM_STATS_SHOWN - 1; i++)
+    {
+        s32 lo, hi, k, s = gSineTable[((sEeg->phase * 2) + i * 53) & 0xFF]; // −256 … 256
+        if (sEeg->current == 0xFFFF) { lo = 40; hi = 70; }
+        else if (up != down && i == up) { lo = 205; hi = 256; }
+        else if (up != down && i == down) { lo = 38; hi = 77; }
+        else { lo = 115; hi = 180; }
+        k = lo + (hi - lo) * (s + 256) / 512; // /256
+        colors[i * 2] = RGB(sLobes[i].r * k / 256, sLobes[i].g * k / 256, sLobes[i].b * k / 256);
+        colors[i * 2 + 1] = RGB(sLobes[i].r * k / 512, sLobes[i].g * k / 512, sLobes[i].b * k / 512);
+    }
+    LoadPalette(colors, BG_PLTT_ID(PAL_HEAD) + H_LOBE0, sizeof(colors));
+    // the skull lights up while the NATURE tab is open
+    colors[0] = sEeg->tab == TAB_NATURE && sEeg->current != 0xFFFF ? RGB(15, 19, 19) : RGB(6, 10, 10);
+    LoadPalette(colors, BG_PLTT_ID(PAL_HEAD) + H_SKULL, sizeof(u16));
+}
