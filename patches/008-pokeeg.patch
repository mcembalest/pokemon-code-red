+    gMultiuseListMenuTemplate.lettersSpacing = 1;
+    gMultiuseListMenuTemplate.itemVerticalPadding = 2;
+    gMultiuseListMenuTemplate.upText_Y = 2;
+    gMultiuseListMenuTemplate.maxShowed = sEeg->maxShowed;
+    gMultiuseListMenuTemplate.fontId = FONT_NORMAL;
+    gMultiuseListMenuTemplate.cursorPal = 2;
+    gMultiuseListMenuTemplate.fillValue = 0;
+    gMultiuseListMenuTemplate.cursorShadowPal = 3;
+    gMultiuseListMenuTemplate.moveCursorFunc = Eeg_MoveCursor;
+    gMultiuseListMenuTemplate.itemPrintFunc = Eeg_PrintItem;
+    gMultiuseListMenuTemplate.scrollMultiple = 0;
+    gMultiuseListMenuTemplate.cursorKind = 0;
+}
+
+static void Eeg_MoveCursor(s32 index, bool8 onInit, struct ListMenu *list)
+{
+    if (onInit != TRUE)
+        PlaySE(SE_SELECT);
+    FillWindowPixelBuffer(WIN_MIND, 0);
+    if (index == LIST_CANCEL)
+    {
+        gCodeRedEeg.personality = 0;
+        Eeg_Print(WIN_MIND, FONT_NORMAL, sText_ExitDesc, 2, 3, MIND_COLOR);
+    }
+    else
+    {
+        Eeg_Print(WIN_MIND, FONT_NORMAL, sText_Asking, 2, 3, MIND_COLOR);
+        Eeg_Ask(1, &sEeg->entries[index]);
+    }
+    CopyWindowToVram(WIN_MIND, COPYWIN_GFX);
+}
+
+static void Eeg_PrintItem(u8 windowId, u32 index, u8 y)
+{
+    const struct EegEntry *e;
+    u8 *s;
+    if (index == LIST_CANCEL)
+        return;
+    e = &sEeg->entries[index];
+    s = StringCopy(gStringVar4, gText_Lv);
+    ConvertIntToDecimalStringN(s, e->level, STR_CONV_MODE_LEFT_ALIGN, 3);
+    Eeg_Print(windowId, FONT_SMALL, gStringVar4, 84, y, 2);
+    if (e->box == 0xFF)
+        StringCopy(gStringVar4, sText_Party);
+    else
+    {
+        s = StringCopy(gStringVar4, sText_Box);
+        ConvertIntToDecimalStringN(s, e->box + 1, STR_CONV_MODE_LEFT_ALIGN, 2);
+    }
+    Eeg_Print(windowId, FONT_SMALL, gStringVar4, 122, y, 2);
+}
