+static void Eeg_Init(MainCallback callback)
+{
+    sEeg = Alloc(sizeof(struct EegState));
+    gCodeRedEeg = Alloc(sizeof(struct CodeRedEeg));
+    if (sEeg == NULL || gCodeRedEeg == NULL) { Eeg_Free(); SetMainCallback2(callback); return; }
+    memset(sEeg, 0, sizeof(*sEeg));
+    memset((void *)gCodeRedEeg, 0, sizeof(*gCodeRedEeg));
+    sEeg->savedCallback = callback;
+    sEeg->arrows = 0xFF;
+    sEeg->shownId = 0xFFFFFFFF;
+    sEeg->current = 0xFFFF;
+    SetMainCallback2(Eeg_RunSetup);
+}
